# ==============================================================================
# SignConnect AI - Environment Configuration Example
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Configuration (FastAPI)
# ------------------------------------------------------------------------------
PROJECT_NAME="SignConnect AI"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Security & Authentication (Change in production)
SECRET_KEY="signconnect-ai-super-secret-production-key-2026-isl-platform"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# Default: Local SQLite (Zero-setup development)
DATABASE_URL="sqlite:///./signconnect.db"
# Production PostgreSQL Example:
# DATABASE_URL="postgresql+psycopg2://postgres:password@localhost:5432/signconnect_db"

# Cross-Origin Resource Sharing (CORS)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:8000","http://127.0.0.1:8000"]

# AI / ML Model Parameters
MODEL_WEIGHTS_PATH="backend/app/services/ai/models/isl_classifier.pt"
ISL_DATASET_DIR="backend/app/services/ai/data"
RECOGNITION_CONFIDENCE_THRESHOLD=0.65

# WebRTC & Signaling
MAX_ROOM_PARTICIPANTS=10

# ------------------------------------------------------------------------------
# Frontend Configuration (Next.js)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL="http://127.0.0.1:8000/api/v1"
NEXT_PUBLIC_WS_URL="ws://127.0.0.1:8000/api/v1/ws"
